# Porta HTTP
PORT=3000
TZ=America/Sao_Paulo

# Senha da gestão/PCM (Telas 2 e 3). OBRIGATÓRIO trocar.
GESTAO_SENHA=troque-esta-senha
# Segredo para assinar a sessão (string longa e aleatória)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Armazenamento: "json" (arquivo local, padrão) ou "sheets" (Google Sheets)
STORAGE=json
DATA_DIR=./data

# --- Somente se STORAGE=sheets ---
# ID da planilha (trecho da URL entre /d/ e /edit)
GOOGLE_SHEETS_ID=
# Conteúdo JSON da conta de serviço (em uma linha) OU caminho do arquivo:
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./credenciais.json
